{
  "name": "paper-notes",
  "version": "2.3.0",
  "description": "PaperNotes: a study app for Windows. Your notes, slides and past papers, with the tools to actually study them.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:index": "node scripts/build-index.mjs",
    "gen:demo": "node scripts/gen-content.mjs --out demo-content --notes 900 --depth 5 --force",
    "gen:stress": "node scripts/gen-content.mjs --out demo-content --notes 40000 --depth 10 --branch 5 --force",
    "pages": "node scripts/serve-pages.mjs",
    "verify": "node scripts/verify.mjs",
    "sync": "node scripts/sync-school.mjs",
    "check": "node scripts/check-notes.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "vite": "^6.4.4",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.2.0",
    "music-metadata": "^12.2.2"
  },
  "private": true,
  "type": "module",
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
